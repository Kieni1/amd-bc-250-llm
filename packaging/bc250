#!/usr/bin/env bash
# Greenfield multicall entry point for the supported BC-250 product commands.
set -Eeuo pipefail

# Package Python helpers live under immutable /usr. Never create runtime bytecode there.
export PYTHONDONTWRITEBYTECODE=1

LIBEXEC="${BC250_LIBEXEC:-/usr/libexec/bc250-llm-server}"

ROUTES=(
  "agent-mode|$LIBEXEC/agent-mode.sh"
  "benchmark|$LIBEXEC/benchmark.sh"
  "revalidate|$LIBEXEC/revalidate.sh"
  "code|$LIBEXEC/coding-agent/coding-agent.sh"
  "code-commit|$LIBEXEC/coding-agent/commit-agent.sh"
  "compare-mtp|$LIBEXEC/compare-mtp.sh"
  "fetch-mtp|$LIBEXEC/modelctl|apply|mtp|--include-disabled"
  "gitea-review|$LIBEXEC/coding-agent/gitea-review.sh"
  "install|$LIBEXEC/install.sh"
  "maintenance|$LIBEXEC/maintenance.sh"
  "model|$LIBEXEC/modelctl"
  "ocr|$LIBEXEC/ocr.sh"
  "rag|$LIBEXEC/rag"
  "reset|$LIBEXEC/uninstall.sh"
  "ollama-profile|$LIBEXEC/ollama-profile.sh"
  "openwebui-setup|$LIBEXEC/openwebui-setup.py"
  "run-mtp|$LIBEXEC/run-mtp-llamacpp.sh"
  "status|$LIBEXEC/status.sh"
  "support-bundle|$LIBEXEC/support-bundle.sh"
  "storage|$LIBEXEC/storage.py"
  "verify|$LIBEXEC/verify.sh"
)

usage() {
  cat <<'USAGE'
Usage: bc250 COMMAND [ARGUMENTS...]

Core appliance:
  install, status, verify, support-bundle, storage, reset

Models and product workflows:
  model, rag, ocr, openwebui-setup, ollama-profile

Validation and maintenance:
  benchmark, revalidate, maintenance, agent-mode

Optional specialist workflows:
  code, code-commit, gitea-review, compare-mtp, fetch-mtp, run-mtp

Run `bc250 COMMAND --help` where supported.
CU setup uses two standalone commands:
  sudo bc250-cu-live-manager
  sudo bc250-40cu status
USAGE
}

command="${1:-help}"
(($# == 0)) || shift
case "$command" in
  help|-h|--help) usage; exit 0 ;;
esac

for route in "${ROUTES[@]}"; do
  IFS='|' read -r -a fields <<< "$route"
  [[ "${fields[0]}" == "$command" ]] || continue
  exec "${fields[@]:1}" "$@"
done

echo "ERROR: unknown command: $command" >&2
usage >&2
exit 2

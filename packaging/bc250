#!/usr/bin/env bash
# Greenfield multicall entry point for the supported BC-250 product commands.
set -Eeuo pipefail

export PYTHONDONTWRITEBYTECODE=1
LIBEXEC="${BC250_LIBEXEC:-/usr/libexec/bc250-llm-server}"

ROUTES=(
  "advanced|$LIBEXEC/advanced"
  "document|$LIBEXEC/documents/lifecycle.py"
  "health|$LIBEXEC/health.py"
  "install|$LIBEXEC/install.sh"
  "maintenance|$LIBEXEC/maintenance.sh"
  "model|$LIBEXEC/modelctl"
  "ocr|$LIBEXEC/documents/ocr.sh"
  "reset|$LIBEXEC/reset.sh"
  "status|$LIBEXEC/status.sh"
  "support-bundle|$LIBEXEC/support-bundle.sh"
  "storage|$LIBEXEC/storage.py"
  "verify|$LIBEXEC/verify.sh"
  "version|$LIBEXEC/version.py"
)

usage() {
  cat <<'USAGE'
Usage: bc250 COMMAND [ARGUMENTS...]

Appliance:
  install, status, health, verify, version, support-bundle, storage, reset

Managed workflows:
  document, model, ocr, maintenance

Advanced tools:
  advanced

Run `bc250 COMMAND --help` where supported.
CU setup uses two standalone commands:
  sudo bc250-cu-live-manager
  sudo bc250-40cu status
USAGE
}

command="${1:-help}"
(($# == 0)) || shift
case "$command" in
  help|-h|--help) usage; exit 0 ;;
  --version) exec "$LIBEXEC/version.py" --short ;;
  openwebui-setup) echo "ERROR: 'openwebui-setup' moved to 'bc250 advanced openwebui'." >&2; exit 2 ;;
  benchmark) echo "ERROR: 'benchmark' moved to 'bc250 advanced benchmark'." >&2; exit 2 ;;
  agent-mode) echo "ERROR: 'agent-mode' moved to 'bc250 advanced agent'." >&2; exit 2 ;;
esac

for route in "${ROUTES[@]}"; do
  IFS='|' read -r -a fields <<< "$route"
  [[ "${fields[0]}" == "$command" ]] || continue
  exec "${fields[@]:1}" "$@"
done

echo "ERROR: unknown command: $command" >&2
usage >&2
exit 2

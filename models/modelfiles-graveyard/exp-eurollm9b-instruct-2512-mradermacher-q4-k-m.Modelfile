# Test with:
#   sudo bc250 model apply experiments exp-eurollm9b-instruct-2512-mradermacher-q4-k-m
#   quality-checks/translation/10-direct-candidate-screen.sh \
#     exp-eurollm9b-instruct-2512-mradermacher-q4-k-m 1

FROM /var/lib/bc250-llm-server/gguf/experiments/exp-eurollm9b-instruct-2512-mradermacher-q4-k-m/EuroLLM-9B-Instruct-2512.Q4_K_M.gguf

PARAMETER num_gpu 99
PARAMETER num_keep 256
PARAMETER num_ctx 8192
PARAMETER num_predict 2048
# Deterministic translation comparison; the quality screen supplies the task prompt.
PARAMETER temperature 0

# BC250 category: experimental
# Ollama model: exp-ling30-tiny-bloomer-q5-k-m
# Source: bloomer010/Ling-3.0-tiny-GGUF @ latest
# GGUF: Ling-3.0-tiny-Q5_K_M.gguf
# License: MIT
# Role: efficient MoE reasoning/agentic architecture experiment.
#
# Intended role:
# - Measure 7.9B-total / 1.3B-active MoE behavior on BC-250 Vulkan
# - Compare reasoning latency/throughput against LFM2.5, Qwen and GPT-OSS
# - Test coding/agentic capability without committing to the agent service
#
# Ollama 0.33.3 carries a newer llama.cpp baseline, but bailingmoe3 validation
# remains much stronger on CPU/CUDA than this GFX1013 Vulkan path. Treat BC-250
# compatibility/performance as experimental until a full-offload load benchmark.
# Thinking is native and enabled by default; do not globally force think:false.

FROM /var/lib/bc250-llm-server/gguf/experiments/exp-ling30-tiny-bloomer-q5-k-m/Ling-3.0-tiny-Q5_K_M.gguf

PARAMETER num_gpu 99
PARAMETER num_keep 256
# Deliberately conservative versus the 128K upstream context claim.
PARAMETER num_ctx 32768
# Upstream recommended sampling.
PARAMETER temperature 1.0
PARAMETER top_p 0.95
PARAMETER top_k 20

SYSTEM """You are an experimental reasoning and technical assistant. Follow the user's requested output format exactly. Respond in the requested language or the language of the latest request. Preserve technical details, names, dates and numbers, distinguish facts from inference, and prefer correct executable code or commands when coding is requested."""

FROM /var/lib/bc250-llm-server/gguf/experiments/exp-qwen35-9b-davidau-defiant-fable-q6-k/Qwen3.5-9B-The-Defiant-Fable-Uncnr-Heretic-NEO-MAX-Q6_K.gguf

# BC-250: force full GPU offload.
PARAMETER num_gpu 99

# Preserve initial prompt/system context during context eviction.
PARAMETER num_keep 256

# Quality/context compromise for the 8.76 GB Q6_K model.
PARAMETER num_ctx 32768

# Qwen3.5 recommended THINKING profile for general tasks.
PARAMETER temperature 1.0
PARAMETER top_p 0.95

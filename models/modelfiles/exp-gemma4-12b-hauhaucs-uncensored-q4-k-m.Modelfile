# BC250 category: experiments
# Ollama model: exp-gemma4-12b-hauhaucs-uncensored-q4-k-m
# Acquisition/capability metadata: models/model-catalog.json
FROM __BC250_SOURCE__

# BC-250: Ollama once chose 13/25 GPU layers (22 vs 84 tok/s). Do not remove.
PARAMETER num_gpu 99
# Preserve the SYSTEM prefix when old context is evicted.
PARAMETER num_keep 256
RENDERER gemma4-large
PARSER gemma4
CAPABILITY thinking
PARAMETER num_ctx 16384
PARAMETER temperature 0.6
PARAMETER top_p 0.9
PARAMETER top_k 64
PARAMETER min_p 0.05
PARAMETER repeat_penalty 1.1
SYSTEM """You are an experimental general, document, coding, and creative assistant. Be direct and dependable, follow the requested format, and state uncertainty instead of fabricating details. Answer in the user's language."""

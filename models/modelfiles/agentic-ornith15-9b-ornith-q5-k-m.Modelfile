# BC250 category: agentic
# Ollama model: agentic-ornith15-9b-ornith-q5-k-m
# Acquisition/capability metadata: models/model-catalog.json
#
# License: MIT
#
# Intended role:
# - Primary coding / agentic model
# - Tool use
# - Repository analysis
# - Complex coding tasks
#
# Ornith 1.5 is a native reasoning model.
# Do NOT suppress its <think> reasoning.

FROM __BC250_SOURCE__

# BC-250: force full GPU offload.
PARAMETER num_gpu 99

# Preserve initial/system context during eviction.
PARAMETER num_keep 256

# Practical BC-250 context target.
PARAMETER num_ctx 32768

# BC-250 qualification profile: deterministic sampling eliminated fenced-output variability.
PARAMETER num_predict 3072
PARAMETER temperature 0
PARAMETER top_p 0.95
PARAMETER top_k 20
PARAMETER min_p 0.0
PARAMETER repeat_penalty 1.0

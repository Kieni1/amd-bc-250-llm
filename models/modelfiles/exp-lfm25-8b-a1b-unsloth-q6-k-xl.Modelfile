# BC250 category: experiments
# Ollama model: exp-lfm25-8b-a1b-unsloth-q6-k-xl
# Acquisition/capability metadata: models/model-catalog.json
#
# Experimental fast assistant / RAG / translation challenger. Keep optional until
# exact-device BC-250 qualification proves quality, memory, latency and tool behavior.
FROM __BC250_SOURCE__

PARAMETER num_gpu 99
PARAMETER num_keep 256
RENDERER lfm2
PARSER lfm2
PARAMETER num_ctx 8192
PARAMETER temperature 0.2
PARAMETER top_k 80
PARAMETER repeat_penalty 1.05
SYSTEM """You are an experimental office assistant. Be concise, preserve names, numbers, dates and modality, use retrieval evidence when supplied, and answer in the user's language."""

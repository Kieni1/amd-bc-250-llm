# BC250 category: experimental
# Ollama model: exp-tir-qwen35-9b-nonthinking-v2-q6-k
# Source: mradermacher/TIR-Qwen3.5-9B-NonThinking-v2-GGUF @ latest
# Base fine-tune: HEART77/TIR-Qwen3.5-9B-NonThinking-v2
# GGUF: TIR-Qwen3.5-9B-NonThinking-v2.Q6_K.gguf
# Role: direct/non-thinking 9B office and RAG comparison against stock Qwen3.5-9B.
#
# This model is intentionally evaluated as a non-thinking alternative; do not
# add a forced reasoning policy to the Modelfile.

FROM /var/lib/bc250-llm-server/gguf/experiments/exp-tir-qwen35-9b-nonthinking-v2-q6-k/TIR-Qwen3.5-9B-NonThinking-v2.Q6_K.gguf

# BC-250: force full GPU offload.
PARAMETER num_gpu 99

# Preserve initial/system context during eviction.
PARAMETER num_keep 256

# Match the appliance's Qwen3.5 comparison context.
PARAMETER num_ctx 32768

# Qwen3.5 non-thinking/general-task sampling profile.
PARAMETER temperature 0.7
PARAMETER top_p 0.8
PARAMETER top_k 20
PARAMETER min_p 0.0
PARAMETER repeat_penalty 1.0

SYSTEM """You are a precise multilingual office assistant for German-, French-, and English-speaking users. Follow the user's requested task exactly. Preserve names, numbers, dates, terminology, qualifications, and important distinctions. Distinguish facts from inference and state when information is missing. Respond directly in the requested language, or the language of the latest request when unspecified."""

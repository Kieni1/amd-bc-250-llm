# BC250 category: experiments
# Ollama model: exp-lfm3-vl-2b-liquidai-q6-k
# Acquisition/capability metadata: models/model-catalog.json
# Official compact multilingual document-vision/OCR challenger; not a Tika replacement.
FROM __BC250_SOURCE__
PARAMETER num_gpu 99
PARAMETER num_keep 256
PARAMETER num_ctx 8192
PARAMETER temperature 0.1
PARAMETER top_p 1.0
PARAMETER top_k 50
PARAMETER min_p 0.0
PARAMETER repeat_penalty 1.1

#
# Retrieval embedding model:
# 677M parameters, 1024-d embeddings, 32768-token context,
# with upstream GGUF pooling metadata required for correct Ollama embedding detection.

FROM /var/lib/bc250-llm-server/gguf/embedding/v5-small-retrieval-Q4_K_M.gguf

# Force GPU offload on BC-250.
PARAMETER num_gpu 99

# BC-250 packaged context cap; upstream model metadata supports a larger context.
PARAMETER num_ctx 4096

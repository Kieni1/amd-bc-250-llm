# BC250 category: production
# Ollama model: prod-qwen35-9b-unsloth-q6-k
# Source: unsloth/Qwen3.5-9B-GGUF @ latest
# GGUF: Qwen3.5-9B-Q6_K.gguf
FROM /var/lib/bc250-llm-server/gguf/production/Qwen3.5-9B-Q6_K.gguf

# BC-250: Ollama once chose 13/25 GPU layers (22 vs 84 tok/s). Do not remove.
PARAMETER num_gpu 99
# Preserve the SYSTEM prefix when old context is evicted.
PARAMETER num_keep 256
PARAMETER num_ctx 32768
PARAMETER temperature 0.7
PARAMETER top_p 0.8
PARAMETER top_k 20
SYSTEM """You are a production general office assistant. Answer clearly and directly, distinguish facts from guesses, and respond in the requested language, or the latest user's language when unspecified. Formulate responses directly and idiomatically in German, French or English rather than drafting in another language and translating it."""

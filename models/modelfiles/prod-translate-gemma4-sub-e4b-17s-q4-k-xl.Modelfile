# BC250 category: production
# Ollama model: prod-translate-gemma4-sub-e4b-17s-q4-k-xl
# Acquisition/capability metadata: models/model-catalog.json
# License: Apache-2.0
# Role: production German/French translation base selected by Stage-2E.
#
# The exact DE→FR / FR→DE product contract is owned by the package Open WebUI
# model presets and direction filter. Keep this base free of a second SYSTEM prompt.

FROM __BC250_SOURCE__

PARAMETER num_gpu 99
PARAMETER num_keep 256
PARAMETER num_ctx 8192
# Stage-2E showed 1024 could truncate long output; 2048 is the selected budget.
PARAMETER num_predict 2048
# Published Translate-Gemma examples and the selected BC-250 contract are deterministic.
PARAMETER temperature 0

# BC250 category: experimental
# Ollama model: exp-qwen36-14b-a3b-tvall43-fablevibes-q4-k-m
# Source: tvall43/Qwen3.6-14B-A3B-FableVibes-GGUF @ latest
# GGUF: Qwen3.6-14B-A3B-FableVibes-Q4_K_M.gguf
FROM /var/lib/bc250-llm-server/gguf/experiments/qwen36-14b-a3b-fablevibes-Q4_K_M/Qwen3.6-14B-A3B-FableVibes-Q4_K_M.gguf

# BC-250: Ollama once chose 13/25 GPU layers (22 vs 84 tok/s). Do not remove.
PARAMETER num_gpu 99
# Preserve the SYSTEM prefix when old context is evicted.
PARAMETER num_keep 256
# Leave headroom for the 8.47 GB model and its reasoning output.
PARAMETER num_ctx 16384
PARAMETER temperature 1.0
PARAMETER top_p 0.95
PARAMETER top_k 20

SYSTEM """You are an experimental multilingual document-analysis assistant.
Follow the user's requested task completely. When comparing documents, examine all supplied material before drawing conclusions and identify agreements, differences, contradictions, and missing information.
Preserve important names, numbers, dates, terminology, and qualifications. Distinguish source facts from inference and do not invent missing information.
Respond in the language requested by the user, or the language of the latest request when unspecified."""

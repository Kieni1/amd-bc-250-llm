# BC250 category: experimental
# Ollama model: exp-qwen35-9b-hauhaucs-uncensored-q6-k
# Acquisition/capability metadata: models/model-catalog.json
FROM __BC250_SOURCE__

# BC-250: Ollama once chose 13/25 GPU layers (22 vs 84 tok/s). Do not remove.
PARAMETER num_gpu 99
# Preserve the SYSTEM prefix when old context is evicted.
PARAMETER num_keep 256
PARAMETER num_ctx 32768
PARAMETER temperature 0.7
PARAMETER top_p 0.8
PARAMETER top_k 20
SYSTEM """You are a direct experimental assistant. Follow the user's request, distinguish facts from guesses, and answer in the user's language."""

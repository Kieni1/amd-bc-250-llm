# Copy this file to /etc/bc250-llm-server/models.d/NAME.Modelfile.
# Replace every uppercase placeholder; the filename becomes the Ollama name.
# Categories: production, experimental, task, agentic, embedding
# Name prefixes: prod-, exp-, task-, agentic-, embed-
# Storage names: production, experiments, task, agent, embedding
# BC250 category: CATEGORY
# Ollama model: NAME
# Source: OWNER/REPOSITORY @ latest
# GGUF: MODEL.gguf
# Optional exact source digest; remove this line when the revision is flexible.
# SHA256: 
FROM /var/lib/bc250-llm-server/gguf/STORAGE/MODEL.gguf

# Keep num_gpu in every template. Chat templates also require num_keep.
PARAMETER num_gpu 99
PARAMETER num_keep 256
PARAMETER num_ctx 8192
PARAMETER temperature 0.7
PARAMETER top_p 0.9

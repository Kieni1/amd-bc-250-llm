# BC250 category: experimental
# Ollama model: exp-qwen38-9b-empero-q6-k
# Source: empero-ai/Qwen3.8-9B-Distill-GGUF @ latest
# GGUF: Qwen3.8-9B-Q6_K.gguf
# License: Apache-2.0
# Role: 9B distilled reasoning comparison against stock Qwen3.5-9B and GPT-OSS.
#
# Native reasoning model. Keep thinking enabled/default during evaluation.

FROM /var/lib/bc250-llm-server/gguf/experiments/exp-qwen38-9b-empero-q6-k/Qwen3.8-9B-Q6_K.gguf

# BC-250: force full GPU offload.
PARAMETER num_gpu 99

# Preserve initial/system context during eviction.
PARAMETER num_keep 256

# Same practical comparison context as the production Qwen3.5-9B profile.
PARAMETER num_ctx 32768

# Upstream recommended reasoning sampling.
PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER top_k 20
PARAMETER min_p 0.0
PARAMETER repeat_penalty 1.0

SYSTEM """You are an experimental reasoning assistant for office, technical, coding, and analytical tasks. Follow the user's requested format, distinguish facts from inference, and answer in the requested language or the language of the latest request."""

# BC250 category: experimental
# Ollama model: exp-qwythos9b-v2-empero-q5-k-m
# Source: empero-ai/Qwythos-9B-v2-GGUF @ latest
# GGUF: Qwythos-9B-v2-Q5_K_M.gguf
#
# Intended role:
# - Reasoning
# - Coding / agentic comparison
# - Challenger to Qwable and Ornith
#
# Qwythos v2 is intrinsically a reasoning model.
# Do not suppress its <think> output during evaluation.

FROM /var/lib/bc250-llm-server/gguf/experiments/exp-qwythos9b-v2-empero-q5-k-m/Qwythos-9B-v2-Q5_K_M.gguf

# BC-250: force full GPU offload.
PARAMETER num_gpu 99

# Preserve SYSTEM prefix when old context is evicted.
PARAMETER num_keep 256

# Deliberately below architectural maximum for BC-250 testing.
PARAMETER num_ctx 32768

# Upstream recommended reasoning sampling.
PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER top_k 20

# Optional in v2, retained for consistency/stability.
PARAMETER repeat_penalty 1.05

SYSTEM """You are an experimental reasoning, coding, and agentic assistant. Work through difficult problems carefully, follow the requested format, and clearly distinguish verified results from assumptions or untested work."""

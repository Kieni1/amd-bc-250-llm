# BC250 category: experimental
# Ollama model: exp-glm-ocr-ggml-q8-0
# Acquisition/capability metadata: models/model-catalog.json
#
# Lightweight OCR baseline. Ollama manages the paired vision projector from
# the Hugging Face source. 16K avoids known image/table failures at small ctx.

FROM __BC250_SOURCE__

PARAMETER num_gpu 99
PARAMETER num_keep 256
PARAMETER num_ctx 16384
PARAMETER temperature 0

# BC250 category: task
# Ollama model: task-lfm25-1.2b-instruct-liquidai-q6-k
# Acquisition/capability metadata: models/model-catalog.json
# License: LFM1.0
# Role: production compact Open WebUI title/tag/retrieval-query task model.
# Deliberately no fixed SYSTEM prompt: Open WebUI supplies package-owned task prompts.

FROM __BC250_SOURCE__

PARAMETER num_gpu 99
PARAMETER num_keep 256
PARAMETER num_ctx 4096
PARAMETER num_predict 128
PARAMETER temperature 0.1
PARAMETER top_k 50
PARAMETER repeat_penalty 1.05

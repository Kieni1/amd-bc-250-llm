# BC250 category: experimental
# Ollama model: exp-minicpm-v47-1b-openbmb-q4-k-m
# Acquisition/capability metadata: models/model-catalog.json
#
# Experimental document-vision/OCR helper. Ollama manages the HF model/projector
# assets; this is not a Tika replacement and is not installed by default.
FROM __BC250_SOURCE__

PARAMETER num_gpu 99
PARAMETER num_keep 256
PARAMETER num_ctx 8192
PARAMETER temperature 0.2

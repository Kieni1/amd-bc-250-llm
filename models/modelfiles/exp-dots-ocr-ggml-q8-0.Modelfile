# BC250 category: experimental
# Ollama model: exp-dots-ocr-ggml-q8-0
# Source: ggml-org/dots.ocr-GGUF @ main
# GGUF: dots.ocr-Q8_0.gguf
#
# Multilingual document/layout OCR experiment. Ollama manages the paired
# projector from the Hugging Face source.

FROM hf.co/ggml-org/dots.ocr-GGUF:Q8_0

PARAMETER num_gpu 99
PARAMETER num_keep 256
PARAMETER num_ctx 16384
PARAMETER temperature 0

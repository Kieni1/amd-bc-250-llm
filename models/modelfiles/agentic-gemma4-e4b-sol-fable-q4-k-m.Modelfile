FROM /var/lib/bc250-llm-server/gguf/agent/gemma-4-E4B-v2-Sol-Fable-Q4_K_M.gguf

PARAMETER num_gpu 99
PARAMETER num_keep 256
PARAMETER num_ctx 16384

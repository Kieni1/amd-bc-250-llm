# BC250 category: embedding
# Ollama model: embed-qwen3-0.6b-q8-0
# Acquisition/capability metadata: models/model-catalog.json
# License: Apache-2.0
#
# Text embedding model:
# 0.6B parameters
# 100+ languages
# 32768-token context
# up to 1024 embedding dimensions

FROM __BC250_SOURCE__

# Force GPU offload on BC-250.
PARAMETER num_gpu 99

# BC-250 packaged context cap; upstream model metadata supports a larger context.
PARAMETER num_ctx 4096

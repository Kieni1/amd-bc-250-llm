# BC250 category: task
# Ollama model: task-lfm3-1.7b-liquidai-q6-k
# Acquisition/capability metadata: models/model-catalog.json
# Official LFM3 Q6_K task contender; production LFM2.5 remains default.
# No fixed SYSTEM: Open WebUI owns title/tag/query prompts.
# Qualify explicitly with think=false, direct/live task checks, and warm-main overlap.
FROM __BC250_SOURCE__
PARAMETER num_gpu 99
PARAMETER num_keep 256
PARAMETER num_ctx 4096
PARAMETER num_predict 128
PARAMETER temperature 0.1
PARAMETER top_p 1.0
PARAMETER top_k 50
PARAMETER repeat_penalty 1.1

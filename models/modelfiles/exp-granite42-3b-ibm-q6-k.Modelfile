# BC250 category: experimental
# Ollama model: exp-granite42-3b-ibm-q6-k
# Source: ibm-granite/granite-4.2-3b-GGUF @ latest
# GGUF: granite-4.2-3b-Q6_K.gguf
# License: Apache-2.0
# Role: compact multilingual enterprise/RAG/structured-output comparison.
#
# Intended role:
# - Compact DE/FR/EN office/general assistant comparison
# - Structured JSON and Open WebUI task-quality experiment
# - RAG/document-answering experiment
# - Lightweight reasoning/tool-use capability check
#
# Granite 4.2 has native thinking and is current-generation for Ollama 0.33.2.
# Keep num_ctx explicit: Granite 4.2 GGUF metadata advertises 128K context and
# upstream 0.33.x reports show auto/full-context OOMs on <=16 GB shared-memory
# systems. Verify load/template/think behavior on BC-250 before role promotion.

FROM /var/lib/bc250-llm-server/gguf/experiments/exp-granite42-3b-ibm-q6-k/granite-4.2-3b-Q6_K.gguf

PARAMETER num_gpu 99
PARAMETER num_keep 256
# Keep practical BC-250 headroom even though upstream supports much longer context.
PARAMETER num_ctx 32768
# Upstream Granite 4.2 generation defaults.
PARAMETER temperature 1.0
PARAMETER top_p 0.95

SYSTEM """You are an experimental multilingual office and technical assistant. Respond in the language requested by the user, otherwise in the language of the latest request. Support German, French and English naturally. Follow requested output formats exactly, preserve names, dates, numbers and technical qualifications, and distinguish source-supported facts from inference when documents or retrieved material are supplied."""

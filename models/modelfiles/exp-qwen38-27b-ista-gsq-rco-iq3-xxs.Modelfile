# BC250 category: experiments
# Ollama model: exp-qwen38-27b-ista-gsq-rco-iq3-xxs
# Acquisition/capability metadata: models/model-catalog.json
# License: Apache-2.0
# Role: deployability/RAG-oriented dense 27B experiment for the 16 GiB BC-250 profile.
# Approx source GGUF size: 10.1 GB; ISTA describes IQ3_XXS as a strong all-round operating point.
# RAG/product-path callers should request think=false and own grounding/citation instructions.
# 8K is deliberate on the 16 GiB UMA profile: the earlier 16K configuration
# reached the low-memory safety boundary during sustained RAG qualification.
# Text-only first pass: no vision projector and no MTP payload.

FROM __BC250_SOURCE__

PARAMETER num_gpu 99
PARAMETER num_keep 256
PARAMETER num_ctx 8192
PARAMETER num_predict 1024

# Qwen3.8 non-thinking/instruct sampling recommendations supported by Ollama Modelfile.
# presence_penalty is intentionally omitted because Ollama does not document it as a Modelfile parameter.
PARAMETER temperature 0.7
PARAMETER top_p 0.8
PARAMETER top_k 20
PARAMETER min_p 0.0
PARAMETER repeat_penalty 1.0
PARAMETER repeat_last_n 64

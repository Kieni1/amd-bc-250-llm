# BC250 category: agentic
# Ollama model: agentic-lfm25-24b-a2b-unsloth-q3-k-xl
# Acquisition/capability metadata: models/model-catalog.json
#
# Experimental exclusive-agent-lane challenger. LFM2.5-24B-A2B is an always-
# reasoning/tool-oriented model; keep it off the normal lanes until device proof.
FROM __BC250_SOURCE__

PARAMETER num_gpu 99
PARAMETER num_keep 256
RENDERER lfm2-thinking
PARSER lfm2-thinking
CAPABILITY thinking
PARAMETER num_ctx 8192
PARAMETER num_predict 3072
PARAMETER temperature 0.1
PARAMETER top_k 50
PARAMETER repeat_penalty 1.05

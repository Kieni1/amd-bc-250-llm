# BC250 category: experimental
# Ollama model: exp-chandra-ocr2-prithivmlmods-q4-k-m
# Source: prithivMLmods/chandra-ocr-2-GGUF @ main
# GGUF: chandra-ocr-2.Q4_K_M.gguf
#
# Compatibility probe. Chandra has had split-Qwen3.5 vision failures in Ollama;
# a successful create is not enough. Run bc250-ocr test with a real page.

FROM hf.co/prithivMLmods/chandra-ocr-2-GGUF:Q4_K_M

PARAMETER num_gpu 99
PARAMETER num_keep 256
PARAMETER num_ctx 8192
PARAMETER temperature 0

# BC250 category: experimental
# Ollama model: exp-qwen38-9b-distill-empero-q5-k-m
# Source: empero-ai/Qwen3.8-9B-Distill-GGUF @ latest
# GGUF: Qwen3.8-9B-Q5_K_M.gguf
#
# Intended role:
# - Deep reasoning
# - Math / coding
# - Compare against GPT-OSS 20B, Qwythos v2, and Qwen3.6 FableVibes
#
# This is a reasoning distill.
# Do not suppress its <think> output during evaluation.

FROM /var/lib/bc250-llm-server/gguf/experiments/exp-qwen38-9b-distill-empero-q5-k-m/Qwen3.8-9B-Q5_K_M.gguf

# BC-250: force full GPU offload.
PARAMETER num_gpu 99

# Preserve SYSTEM prefix when old context is evicted.
PARAMETER num_keep 256

# Balanced context/headroom for this 6.64 GB model.
PARAMETER num_ctx 32768

# Upstream recommended reasoning sampling.
PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER top_k 20

SYSTEM """You are an experimental reasoning assistant focused on difficult analytical, mathematical, coding, and document problems. Reason carefully, follow the requested format, and distinguish conclusions from assumptions."""

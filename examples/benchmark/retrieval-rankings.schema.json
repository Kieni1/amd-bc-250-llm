{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bc250.local/schema/retrieval-ranking-row-v1.json",
  "title": "BC-250 retrieval-only ranking row",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "question_id",
    "ranked_chunks"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "arm_id": {
      "type": "string",
      "minLength": 1
    },
    "ranked_chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "chunk_id",
          "document_id",
          "text"
        ],
        "properties": {
          "chunk_id": {
            "type": "string",
            "minLength": 1
          },
          "document_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": [
              "number",
              "null"
            ]
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bc250.local/schema/corpus-manifest-v1.json",
  "title": "BC-250 external quality corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "corpus_id",
    "documents",
    "questions"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "sha256",
        "size_bytes",
        "language",
        "document_type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "language": {
          "enum": [
            "de",
            "fr",
            "en",
            "mixed"
          ]
        },
        "document_type": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        },
        "extraction_gold": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required_any_groups": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "forbidden": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "numbers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "identifiers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "contains": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "query_language",
        "supported",
        "required_evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "query_language": {
          "enum": [
            "de",
            "fr",
            "en"
          ]
        },
        "answer_language": {
          "enum": [
            "de",
            "fr",
            "en"
          ]
        },
        "supported": {
          "type": "boolean"
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "acceptable_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "conflicting_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "exact_values": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "amounts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "identifiers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "answer_oracle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required_any_groups": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "forbidden": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "supported": {
                "const": true
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "required_evidence": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "acceptable_evidence"
                ],
                "properties": {
                  "acceptable_evidence": {
                    "minItems": 1
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "supported": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "required_evidence": {
                "maxItems": 0
              },
              "acceptable_evidence": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}

#!/usr/bin/env bash
# Bootstrap a BC-250 appliance: install the RPM, then hand off.
set -Eeuo pipefail

RPM_PATH="${1:-$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")}" 
[[ ${EUID} -eq 0 ]] || { echo "ERROR: run with sudo." >&2; exit 1; }
[[ "${1:-}" != -h && "${1:-}" != --help ]] || {
  echo "Usage: sudo ./install [RPM-FILE-OR-DIRECTORY]"
  exit 0
}

find_rpm() {
  local target="$RPM_PATH" candidate
  if [[ -f "$target" ]]; then
    [[ "$target" == *.x86_64.rpm && "$target" != *.src.rpm ]] || {
      echo "ERROR: expected a bc250-llm-server x86_64 RPM: $target" >&2; exit 2;
    }
    readlink -f -- "$target"; return
  fi
  candidate="$(find "$target" -maxdepth 1 -type f -name 'bc250-llm-server-*.x86_64.rpm' ! -name '*.src.rpm' -print | sort -V | tail -1)"
  [[ -n "$candidate" ]] || { echo "ERROR: no bc250-llm-server x86_64 RPM found in $target" >&2; exit 2; }
  readlink -f -- "$candidate"
}

rpm_file="$(find_rpm)"
echo "Installing $rpm_file"
dnf install -y --setopt=install_weak_deps=False --exclude=ollama "$rpm_file"
hash -r
exec bc250-install

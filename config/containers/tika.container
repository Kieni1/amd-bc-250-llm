# Packaged rootful Quadlet. Tika is deliberately not published on the host.
[Unit]
Description=Apache Tika (private document text extraction service)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=tika
# 4.2.0-full, pinned OCI index digest.
Image=docker.io/apache/tika@sha256:4774eaac44f86cdf648ae7b5a367016eaf6f9052adec31e5cff07cff1a0c6e24
Network=llm.network
NetworkAlias=tika
Memory=1g
PidsLimit=256
NoNewPrivileges=true
DropCapability=all

[Service]
# Podman/Tika exits 143 on the expected SIGTERM stop path used by systemd restart.
# Treat only that expected termination status as successful; other failures remain failures.
SuccessExitStatus=143
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

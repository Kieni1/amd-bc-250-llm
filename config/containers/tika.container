# Packaged rootful Quadlet. Tika is deliberately not published on the host.
[Unit]
Description=Apache Tika (private document text extraction service)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=tika
# 4.1.0-full, pinned OCI index digest.
Image=docker.io/apache/tika@sha256:d7607239d4e9c2dc1fd396f41a370576a334aef28f767e5bc5511247a1e1adf7
Network=llm.network
NetworkAlias=tika
Memory=1g
PidsLimit=256
NoNewPrivileges=true
DropCapability=all

[Service]
# Podman/Tika exits 143 on the expected SIGTERM stop path used by systemd restart.
# Treat only that expected termination status as successful; other failures remain failures.
SuccessExitStatus=143
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

# Packaged rootful Quadlet. Tika is deliberately not published on the host.
[Unit]
Description=Apache Tika (private document text extraction service)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=tika
# 4.0.0-full, pinned OCI index digest.
Image=docker.io/apache/tika@sha256:80072bb73dd320a9de9709beb0b16d14dd6d2680376f8d31e498f55b633ba593
Network=llm.network
NetworkAlias=tika
Memory=1g
PidsLimit=256
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

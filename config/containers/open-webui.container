# Packaged rootful Quadlet. Application desired state is applied through
# bc250-openwebui-setup from /usr/share/bc250-llm-server/openwebui/desired-state.json.
[Unit]
Description=Open WebUI (BC-250 local LLM front-end)
After=network-online.target ollama.service ollama-task.service ollama-embedding.service tika.service
Wants=network-online.target tika.service

[Container]
ContainerName=open-webui
# v0.11.3, pinned OCI index digest.
Image=ghcr.io/open-webui/open-webui@sha256:751b617714b91e4cfd0186a509c72480c858e012976103b09a30dad053c36175
Network=llm.network
NetworkAlias=open-webui
PublishPort=127.0.0.1:3000:8080
Volume=/var/lib/open-webui:/app/backend/data:Z,U
AddHost=host.containers.internal:host-gateway
Memory=2g
PidsLimit=512
NoNewPrivileges=true
DropCapability=all

# Process bootstrap only. Persisted providers, task settings, embedding backend
# and RAG chunking are owned by bc250-openwebui-setup through supported APIs.
Environment=OLLAMA_BASE_URL=http://host.containers.internal:11434
Environment=WEBUI_AUTH=true
EnvironmentFile=/var/lib/bc250-llm-server/secrets/open-webui.env
Environment=ENABLE_OPENAI_API=false
Environment=OFFLINE_MODE=true
Environment=HF_HUB_OFFLINE=1
Environment=RAG_EMBEDDING_MODEL_AUTO_UPDATE=false
Environment=RAG_RERANKING_MODEL_AUTO_UPDATE=false
Environment=WHISPER_MODEL_AUTO_UPDATE=false
Environment=ENABLE_COMMUNITY_SHARING=false
Environment=ENABLE_CODE_EXECUTION=false
Environment=ENABLE_CODE_INTERPRETER=false
Environment=ENABLE_MEMORIES=false
Environment=ENABLE_DIRECT_CONNECTIONS=false
Environment=ENABLE_PIP_INSTALL_FRONTMATTER_REQUIREMENTS=false

# Runtime-only upload/residency controls that are not part of the persisted
# Open WebUI application desired-state API contract.
Environment=RAG_FILE_MAX_SIZE=128
Environment=RAG_FILE_MAX_COUNT=20
Environment="RAG_ALLOWED_FILE_EXTENSIONS=pdf,txt,md,csv,tsv,doc,docx,xls,xlsx,ppt,pptx,odt,ods,odp,rtf,html,htm,xml,json,epub"
Environment=RAG_SYSTEM_CONTEXT=false
Environment="RAG_EMBEDDING_QUERY_PREFIX=Query: "
Environment="RAG_EMBEDDING_CONTENT_PREFIX=Document: "
Environment=ENABLE_KNOWLEDGE_FILE_RETENTION=false
Environment=SCARF_NO_ANALYTICS=true
Environment=DO_NOT_TRACK=true

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=900

[Unit]
Description=BC-250 exclusive agent Ollama instance
After=network-online.target cyan-skillfish-governor-smu.service
Wants=network-online.target cyan-skillfish-governor-smu.service
Conflicts=ollama.service ollama-task.service ollama-embedding.service

[Service]
Type=simple
User=ollama
Group=ollama
SupplementaryGroups=render video
ExecStart=/usr/local/bin/ollama serve
Restart=always
RestartSec=3
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
NoNewPrivileges=true
Environment="HOME=/var/lib/ollama"
Environment="OLLAMA_VULKAN=1"
Environment="OLLAMA_NO_CLOUD=1"
Environment="GGML_VK_VISIBLE_DEVICES=0"
Environment="OLLAMA_IGPU_ENABLE=1"
Environment="OLLAMA_HOST=0.0.0.0:11436"
Environment="OLLAMA_MODELS=/var/lib/bc250-llm-server/ollama/agent"
Environment="OLLAMA_MAX_LOADED_MODELS=1"
Environment="OLLAMA_NUM_PARALLEL=1"
Environment="OLLAMA_KEEP_ALIVE=5m"
Environment="OLLAMA_CONTEXT_LENGTH=32768"
Environment="OLLAMA_FLASH_ATTENTION=1"
Environment="OLLAMA_KV_CACHE_TYPE=q8_0"
